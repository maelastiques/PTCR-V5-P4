COMMAND_PATTERN = re.compile(r"\{\s*(execute_full|execute_drc|execute_erc)\s*\}", re.IGNORECASE)

# Approximate OpenAI pricing in USD per 1M tokens.
MODEL_PRICING_PER_1M = {
    "gpt-5": {"input": 5.00, "output": 15.00},
    "gpt-5-mini": {"input": 0.30, "output": 1.20},
    "gpt-5-nano": {"input": 0.05, "output": 0.20},
    "gpt-4.1": {"input": 2.00, "output": 8.00},
    "gpt-4.1-mini": {"input": 0.40, "output": 1.60},
    "gpt-4.1-nano": {"input": 0.10, "output": 0.40},
    "gpt-4o": {"input": 5.00, "output": 15.00},
    "gpt-4o-mini": {"input": 0.15, "output": 0.60},
    "o3": {"input": 2.00, "output": 8.00},
    "o3-mini": {"input": 1.10, "output": 4.40},
    "o4-mini": {"input": 0.60, "output": 2.40},
}

# SVG icons in images/.
_IMAGES_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "images")
SVG_ICON_FILES = {
    "send": "send",
    "content_copy": "copy",
    "edit": "edit",
    "close": "close",
}


def _utc_now_iso() -> str:
    return datetime.utcnow().replace(microsecond=0).isoformat() + "Z"


def _is_dark_colour(colour: wx.Colour) -> bool:
    # Relative luminance heuristic for theme adaptation.
    luminance = (0.2126 * colour.Red()) + (0.7152 * colour.Green()) + (0.0722 * colour.Blue())
    return luminance < 128


def _markdown_to_plain(text: str) -> str:
    # Keep markdown readable in static bubbles without full rich renderer.
    lines: List[str] = []
    in_code = False
    in_list = False

    def _append_spacer_once() -> None:
        if lines and lines[-1] != "":
            lines.append("")

    for raw in text.splitlines():
        line = raw.rstrip("\n")
        stripped = line.strip()
        if stripped.startswith("```"):
            if in_list:
                _append_spacer_once()
                in_list = False
            in_code = not in_code
            if in_code:
                lines.append("[code]")
            else:
                lines.append("[/code]")
            continue

        if in_code:
            lines.append("    " + line)
            continue

        if stripped.startswith("# "):
            if in_list:
                _append_spacer_once()
                in_list = False
            _append_spacer_once()
            lines.append(stripped[2:].upper())
            lines.append("")
        elif stripped.startswith("## "):
            if in_list:
                _append_spacer_once()
                in_list = False
            _append_spacer_once()
            lines.append(stripped[3:].upper())
            lines.append("")
        elif stripped.startswith("### "):
            if in_list:
                _append_spacer_once()
                in_list = False
            _append_spacer_once()
            lines.append(stripped[4:])
            lines.append("")
        elif re.match(r"^\d+[\.)]\s+", stripped):
            if not in_list:
                _append_spacer_once()
            in_list = True
            lines.append("  " + stripped)
            lines.append("")
        elif stripped.startswith("- ") or stripped.startswith("* "):
            if not in_list:
                _append_spacer_once()
            in_list = True
            lines.append("  • " + stripped[2:])
            lines.append("")
        elif stripped == "":
            if in_list:
                _append_spacer_once()
                in_list = False
            _append_spacer_once()
        else:
            if in_list:
                _append_spacer_once()
                in_list = False
            lines.append(line)

    while lines and lines[-1] == "":
        lines.pop()
    return "\n".join(lines)


def _model_pricing(model: str) -> Dict[str, float]:
    model_key = (model or "").strip().lower()
    if model_key in MODEL_PRICING_PER_1M:
        return MODEL_PRICING_PER_1M[model_key]

    for known, pricing in MODEL_PRICING_PER_1M.items():
        if model_key.startswith(known):
            return pricing

    return {"input": 0.0, "output": 0.0}


def _svg_bitmap(name: str, size: int) -> wx.Bitmap:
    """Rasterise a bundled SVG icon to the requested pixel size."""
    if not _WX_SVG:
        return wx.NullBitmap
    svg_file = SVG_ICON_FILES.get(name)
    if not svg_file:
        return wx.NullBitmap
    path = os.path.join(_IMAGES_DIR, f"{svg_file}.svg")
    if not os.path.isfile(path):
        return wx.NullBitmap
    try:
        img = _wx_svg.SVGimage.CreateFromFile(path)
        bmp = img.ConvertToScaledBitmap((size, size))
        return bmp if bmp.IsOk() else wx.NullBitmap
    except Exception:
        return wx.NullBitmap


def _icon_bitmap(name: str, size: int = 18) -> wx.Bitmap:
    """Return an SVG bitmap or NullBitmap if the icon is not available."""
    return _svg_bitmap(name, size)


class RoundedPanel(wx.Panel):
    """Panel with a rounded-rectangle custom background.

    Key design rule: SetBackgroundColour is called with the bubble's OWN
    colour (not the parent's).  This means child wx.StaticText widgets
    correctly inherit the bubble colour as their background, which makes
    the sizer-border padding visible instead of being masked by a
    mismatched system colour.
    """

    def __init__(self, parent: wx.Window, bg: wx.Colour, border: wx.Colour, radius: int = 10) -> None:
        super().__init__(parent, style=wx.BORDER_NONE)
        self._bg = bg
        self._border = border
        self._radius = radius
        # Store the bubble's own colour so children inherit it correctly.
        self.SetBackgroundColour(bg)
        self.SetBackgroundStyle(wx.BG_STYLE_PAINT)
        self.Bind(wx.EVT_PAINT, self._on_paint)
        self.Bind(wx.EVT_SIZE, self._on_size)

    def _on_size(self, _event: wx.SizeEvent) -> None:
        self.Refresh()

    def _on_paint(self, _event: wx.PaintEvent) -> None:
        dc = wx.AutoBufferedPaintDC(self)
        # Clear using the PARENT's background so the rounded corners blend in.
        dc.SetBackground(wx.Brush(self.GetParent().GetBackgroundColour()))
        dc.Clear()
        rect = self.GetClientRect()
        if rect.width <= 1 or rect.height <= 1:
            return
        dc.SetPen(wx.Pen(self._border, 1))
        dc.SetBrush(wx.Brush(self._bg))
        draw_rect = wx.Rect(rect.x, rect.y, max(0, rect.width - 1), max(0, rect.height - 1))
        dc.DrawRoundedRectangle(draw_rect, self._radius)


class ChatFrame(wx.Frame):
    def __init__(self, board_file: str, context_dir: str) -> None:
        super().__init__(None, title="Maelectrix Chat", size=(1080, 680))
        self.board_file = board_file
        self.context_root_dir = context_dir
        self.chats_root_dir = os.path.join(self.context_root_dir, "chats")
        self.current_session_id = ""
        self.current_session_dir = ""
        self.current_session_meta: Dict[str, Any] = {}
        self.history: List[Dict[str, str]] = []
        self._session_items: List[Dict[str, Any]] = []
        self._is_busy = False
        self._typing_timer = wx.Timer(self)
        self._typing_step = 0
        self._typing_container: Any = None
        self._typing_label: Any = None
        self.is_macos = wx.Platform == "__WXMAC__"
        self.theme_fg = wx.SystemSettings.GetColour(wx.SYS_COLOUR_WINDOWTEXT)
        self.theme_bg = wx.SystemSettings.GetColour(wx.SYS_COLOUR_WINDOW)
        self.theme_hint = wx.SystemSettings.GetColour(wx.SYS_COLOUR_GRAYTEXT)
        self.theme_is_dark = _is_dark_colour(self.theme_bg)
        self._bubble_bodies: List[wx.Window] = []
        self._settings = PluginSettings()

        if self.theme_is_dark:
            self.user_bg = wx.Colour(36, 102, 214)
            self.ai_bg = wx.Colour(46, 46, 52)
            self.system_bg = wx.Colour(64, 64, 70)
            self.error_bg = wx.Colour(110, 38, 38)
            self.user_fg = wx.Colour(255, 255, 255)
            self.ai_fg = wx.Colour(240, 240, 240)
            self.panel_bg = wx.Colour(32, 32, 36)
            self.input_bg = wx.Colour(38, 38, 42)
            self.accent = wx.Colour(74, 144, 255)
            self.button_bg = wx.Colour(56, 56, 62)
            self.button_fg = wx.Colour(236, 236, 236)
            self.border_soft = wx.Colour(78, 78, 84)
        else:
            self.user_bg = wx.Colour(220, 235, 255)
            self.ai_bg = wx.Colour(244, 246, 250)
            self.system_bg = wx.Colour(235, 235, 235)
            self.error_bg = wx.Colour(255, 228, 228)
            self.user_fg = wx.Colour(10, 10, 10)
            self.ai_fg = self.theme_fg
            self.panel_bg = wx.Colour(248, 249, 251)
            self.input_bg = wx.Colour(255, 255, 255)
            self.accent = wx.Colour(36, 102, 214)
            self.button_bg = wx.Colour(236, 239, 244)
            self.button_fg = wx.Colour(24, 24, 24)
            self.border_soft = wx.Colour(206, 211, 219)

        panel = wx.Panel(self)
        panel.SetBackgroundColour(self.panel_bg)
        root = wx.BoxSizer(wx.HORIZONTAL)

        left = wx.Panel(panel)
        left.SetBackgroundColour(self.panel_bg)
        left_sizer = wx.BoxSizer(wx.VERTICAL)
        left_title = wx.StaticText(left, label="Chats")
        left_title.SetForegroundColour(self.theme_fg)
        left_title_font = left_title.GetFont()
        left_title_font.MakeBold()
        left_title.SetFont(left_title_font)
        left_sizer.Add(left_title, 0, wx.ALL, 8)

        self.chat_list = wx.ListBox(left)
        self.chat_list.SetBackgroundColour(self.input_bg)
        self.chat_list.SetForegroundColour(self.theme_fg)
        left_sizer.Add(self.chat_list, 1, wx.LEFT | wx.RIGHT | wx.BOTTOM | wx.EXPAND, 8)

        left_buttons = wx.BoxSizer(wx.HORIZONTAL)
        self.btn_new_chat = wx.Button(left, label="Nouveau")
        self.btn_delete_chat = wx.Button(left, label="Supprimer")
        left_buttons.Add(self.btn_new_chat, 1, wx.RIGHT, 6)
        left_buttons.Add(self.btn_delete_chat, 1)
        left_sizer.Add(left_buttons, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM | wx.EXPAND, 8)
        left.SetSizer(left_sizer)

        right = wx.Panel(panel)
        right.SetBackgroundColour(self.panel_bg)
        right_sizer = wx.BoxSizer(wx.VERTICAL)

        header_row = wx.BoxSizer(wx.HORIZONTAL)
        self.info = wx.StaticText(right, label="Context: (none)")
        self.info.SetForegroundColour(self.theme_hint)
        header_row.Add(self.info, 1, wx.ALIGN_CENTER_VERTICAL | wx.RIGHT, 8)

        self.budget_info = wx.StaticText(right, label="Budget: n/a")
        self.budget_info.SetForegroundColour(self.theme_hint)
        budget_font = self.budget_info.GetFont()
        budget_font.MakeBold()
        self.budget_info.SetFont(budget_font)
        header_row.Add(self.budget_info, 0, wx.ALIGN_CENTER_VERTICAL)
        right_sizer.Add(header_row, 0, wx.ALL | wx.EXPAND, 8)

        self.messages_scroll = wx.ScrolledWindow(right, style=wx.VSCROLL | wx.BORDER_NONE)
        self.messages_scroll.SetBackgroundColour(self.panel_bg)
        self.messages_scroll.SetScrollRate(0, 14)
        self.messages_sizer = wx.BoxSizer(wx.VERTICAL)
        self.messages_scroll.SetSizer(self.messages_sizer)
        right_sizer.Add(self.messages_scroll, 1, wx.LEFT | wx.RIGHT | wx.BOTTOM | wx.EXPAND, 8)

        input_card = RoundedPanel(right, bg=self.input_bg, border=self.border_soft, radius=10)
        input_row = wx.BoxSizer(wx.HORIZONTAL)

        self.input = wx.TextCtrl(input_card, style=wx.TE_MULTILINE | wx.BORDER_NONE)
        self.input.SetBackgroundColour(self.input_bg)
        self.input.SetForegroundColour(self.theme_fg)
        if hasattr(self.input, "SetHint"):
            self.input.SetHint("Pose ta question d'ingenierie...")
        self.input.SetMinSize((480, 52))
        self.btn_send = self._make_send_button(input_card)
        input_row.Add(self.input, 1, wx.ALL | wx.EXPAND, 8)
        input_row.Add(self.btn_send, 0, wx.ALL | wx.ALIGN_CENTER_VERTICAL, 8)

        input_card.SetSizer(input_row)
        right_sizer.Add(input_card, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM | wx.EXPAND, 8)

        buttons = wx.BoxSizer(wx.HORIZONTAL)
        self.btn_settings = wx.Button(right, label="Paramètres")
        self.btn_marker = wx.Button(right, label="Capture")
        buttons.Add(self.btn_settings, 0, wx.RIGHT, 8)
        buttons.Add(self.btn_marker, 0)
        right_sizer.Add(buttons, 0, wx.ALL, 8)

        right.SetSizer(right_sizer)

        root.Add(left, 0, wx.ALL | wx.EXPAND, 6)
        root.Add(right, 1, wx.ALL | wx.EXPAND, 6)
        panel.SetSizer(root)

        self._bind_click_recursive(self.btn_send, self._on_send)
        self.btn_settings.Bind(wx.EVT_BUTTON, self._on_settings)
        self.btn_marker.Bind(wx.EVT_BUTTON, self._on_marker)
        self.input.Bind(wx.EVT_CHAR_HOOK, self._on_input_key)
        self.btn_new_chat.Bind(wx.EVT_BUTTON, self._on_new_chat)
        self.btn_delete_chat.Bind(wx.EVT_BUTTON, self._on_delete_chat)
        self.chat_list.Bind(wx.EVT_LISTBOX, self._on_select_chat)
        self.Bind(wx.EVT_SIZE, self._on_resize)
        self.Bind(wx.EVT_TIMER, self._on_typing_timer, self._typing_timer)

        self._init_chat_sessions()
        wx.CallAfter(self.input.SetFocus)

    def _extract_cost_stats(self, response: Dict[str, Any]) -> Dict[str, Any]:
        usage = response.get("usage", {}) if isinstance(response, dict) else {}
        if not isinstance(usage, dict):
            usage = {}

        prompt_tokens = int(usage.get("prompt_tokens", 0) or 0)
        completion_tokens = int(usage.get("completion_tokens", 0) or 0)
        total_tokens = int(usage.get("total_tokens", prompt_tokens + completion_tokens) or 0)

        model = str(response.get("model", "") or "")
        if not model:
            raw = response.get("raw", {}) if isinstance(response, dict) else {}
            if isinstance(raw, dict):
                model = str(raw.get("model", "") or "")

        pricing = _model_pricing(model)
        prompt_cost = (prompt_tokens * pricing.get("input", 0.0)) / 1_000_000.0
        completion_cost = (completion_tokens * pricing.get("output", 0.0)) / 1_000_000.0
        total_cost = prompt_cost + completion_cost

        return {
            "model": model,
            "prompt_tokens": prompt_tokens,
            "completion_tokens": completion_tokens,
            "total_tokens": total_tokens,
            "prompt_cost_usd": round(prompt_cost, 6),
            "completion_cost_usd": round(completion_cost, 6),
            "total_cost_usd": round(total_cost, 6),
        }

    def _assistant_message_from_response(self, content: str, response: Dict[str, Any]) -> Dict[str, Any]:
        item: Dict[str, Any] = {"role": "assistant", "content": content}
        stats = self._extract_cost_stats(response)
        item.update(stats)
        return item

    def _compute_spend_usd(self) -> float:
        total = 0.0
        if not os.path.isdir(self.chats_root_dir):
            return total

        for name in os.listdir(self.chats_root_dir):
            history_path = self._session_history_path(name)
            history = self._read_json(history_path, [])
            if not isinstance(history, list):
                continue
            for item in history:
                if not isinstance(item, dict):
                    continue
                try:
                    total += float(item.get("total_cost_usd", 0.0) or 0.0)
                except Exception:
                    continue
        return total

    def _update_header_stats(self) -> None:
        self.info.SetLabel(f"Context: {self.current_session_dir or '(none)'}")

        cfg = self._settings.load_runtime_config()
        spend = self._compute_spend_usd()

        try:
            budget_total = float(cfg.get("monthly_budget_usd", 0.0) or 0.0)
        except Exception:
            budget_total = 0.0

        if budget_total > 0.0:
            remaining = max(0.0, budget_total - spend)
            self.budget_info.SetLabel(f"Budget restant: ${remaining:.3f} (depense: ${spend:.3f})")
        else:
            self.budget_info.SetLabel(f"Budget restant: n/a (depense estimee: ${spend:.3f})")

    def _bind_click_recursive(self, widget: wx.Window, handler: Any) -> None:
        widget.Bind(wx.EVT_LEFT_UP, handler)
        for child in widget.GetChildren():
            child.Bind(wx.EVT_LEFT_UP, handler)

    def _make_send_button(self, parent: wx.Window) -> wx.Panel:
        """Creates the Send button: accent RoundedPanel with SVG icon + label."""
        bg = self.accent
        fg = wx.Colour(255, 255, 255)
        panel = RoundedPanel(parent, bg=bg, border=bg, radius=10)
        outer = wx.BoxSizer(wx.HORIZONTAL)
        panel.SetSizer(outer)

        inner = wx.BoxSizer(wx.HORIZONTAL)
        icon_bmp = _icon_bitmap("send", 16)
        if icon_bmp.IsOk():
            icon = wx.StaticBitmap(panel, bitmap=icon_bmp)
            inner.Add(icon, 0, wx.ALIGN_CENTER_VERTICAL | wx.RIGHT, 6)

        lbl = wx.StaticText(panel, label="Envoyer")
        f = lbl.GetFont()
        f.MakeBold()
        lbl.SetFont(f)
        lbl.SetForegroundColour(fg)
        inner.Add(lbl, 0, wx.ALIGN_CENTER_VERTICAL)

        outer.AddStretchSpacer(1)
        outer.Add(inner, 0, wx.ALIGN_CENTER_VERTICAL)
        outer.AddStretchSpacer(1)

        panel.SetMinSize((110, 36))
        panel.SetCursor(wx.Cursor(wx.CURSOR_HAND))
        return panel

    def _make_icon_action(self, parent: wx.Window, icon_name: str, tooltip: str, on_click: Any) -> wx.Window:
        """Creates a small clickable icon.  Falls back to a unicode glyph when no SVG exists."""
        bmp = _icon_bitmap(icon_name, 18)
        if bmp.IsOk():
            widget: wx.Window = wx.StaticBitmap(parent, bitmap=bmp)
        else:
            fallback = {"replay": "\u21ba", "add": "+", "delete": "\u00d7"}.get(icon_name, "•")
            widget = wx.StaticText(parent, label=fallback)
        widget.SetCursor(wx.Cursor(wx.CURSOR_HAND))
        widget.SetToolTip(tooltip)
        widget.Bind(wx.EVT_LEFT_UP, on_click)
        return widget

    def _session_dir(self, session_id: str) -> str:
        return os.path.join(self.chats_root_dir, session_id)

    def _session_meta_path(self, session_id: str) -> str:
        return os.path.join(self._session_dir(session_id), "session.json")

    def _session_history_path(self, session_id: str) -> str:
        return os.path.join(self._session_dir(session_id), "history.json")

    def _read_json(self, path: str, default: Any) -> Any:
        if not os.path.exists(path):
            return default
        try:
            with open(path, "r", encoding="utf-8") as stream:
                return json.load(stream)
        except Exception:
            return default

    def _write_json(self, path: str, payload: Any) -> None:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, indent=2, ensure_ascii=False)

    def _list_sessions(self) -> List[Dict[str, Any]]:
        if not os.path.isdir(self.chats_root_dir):
            return []

        sessions: List[Dict[str, Any]] = []
        for name in os.listdir(self.chats_root_dir):
            session_id = name.strip()
            if not session_id:
                continue
            meta = self._read_json(self._session_meta_path(session_id), {})
            if not isinstance(meta, dict):
                continue
            sessions.append(
                {
                    "id": session_id,
                    "title": str(meta.get("title", "New chat")),
                    "updated_at": str(meta.get("updated_at", "")),
                }
            )

        sessions.sort(key=lambda item: item.get("updated_at", ""), reverse=True)
        return sessions

    def _create_session(self, title: str) -> str:
        session_id = datetime.utcnow().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
        created_at = _utc_now_iso()
        meta = {
            "id": session_id,
            "title": title or "New chat",
            "created_at": created_at,
            "updated_at": created_at,
        }
        self._write_json(self._session_meta_path(session_id), meta)
        self._write_json(self._session_history_path(session_id), [])
        return session_id

    def _refresh_chat_list(self) -> None:
        self._session_items = self._list_sessions()
        self.chat_list.Clear()
        for item in self._session_items:
            self.chat_list.Append(str(item.get("title", "New chat")))

    def _select_session_by_id(self, session_id: str) -> None:
        for index, item in enumerate(self._session_items):
            if str(item.get("id", "")) == session_id:
                self.chat_list.SetSelection(index)
                self._load_session(session_id)
                return

    def _load_session(self, session_id: str) -> None:
        meta = self._read_json(self._session_meta_path(session_id), {})
        history = self._read_json(self._session_history_path(session_id), [])
        if not isinstance(meta, dict):
            return
        if not isinstance(history, list):
            history = []

        self.current_session_id = session_id
        self.current_session_dir = self._session_dir(session_id)
        self.current_session_meta = meta
        self.history = history
        self._update_header_stats()
        self._render_history()

    def _save_current_session(self) -> None:
        if not self.current_session_id:
            return
        meta = dict(self.current_session_meta) if isinstance(self.current_session_meta, dict) else {}
        meta.setdefault("id", self.current_session_id)
        meta.setdefault("title", "New chat")
        meta.setdefault("created_at", _utc_now_iso())
        meta["updated_at"] = _utc_now_iso()
        self.current_session_meta = meta

        self._write_json(self._session_meta_path(self.current_session_id), meta)
        self._write_json(self._session_history_path(self.current_session_id), self.history)

    def _init_chat_sessions(self) -> None:
        os.makedirs(self.chats_root_dir, exist_ok=True)
        sessions = self._list_sessions()
        if not sessions:
            active_id = self._create_session("New chat")
        else:
            active_id = str(sessions[0].get("id", ""))

        self._refresh_chat_list()
        if active_id:
            self._select_session_by_id(active_id)

    def _append_user(self, text: str) -> None:
        self._append_message("You", text, markdown=False, kind="user", history_index=None)

    def _append_assistant(self, text: str) -> None:
        self._append_message("AI", text, markdown=True, kind="assistant", history_index=None)

    def _append_system(self, text: str) -> None:
        self._append_message("System", text, markdown=False, kind="system", history_index=None)

    def _append_error(self, title: str, details: str) -> None:
        payload = self._format_error_card(title, details)
        self._append_message("API Error", payload, markdown=False, kind="error", history_index=None)

    def _append_message(
        self,
        role: str,
        text: str,
        markdown: bool,
        kind: str,
        history_index: Any,
        prompt_cost_usd: float = 0.0,
    ) -> None:
        row = wx.BoxSizer(wx.HORIZONTAL)
        card = wx.BoxSizer(wx.VERTICAL)

        if kind == "user":
            bg = self.user_bg
            fg = self.user_fg
            header_colour = self.user_fg
        elif kind == "system":
            bg = self.system_bg
            fg = self.ai_fg
            header_colour = self.theme_hint
        elif kind == "error":
            bg = self.error_bg
            fg = self.ai_fg
            header_colour = self.theme_hint
        else:
            bg = self.ai_bg
            fg = self.ai_fg
            header_colour = self.theme_hint

        bubble = RoundedPanel(self.messages_scroll, bg=bg, border=self.border_soft, radius=14)
        bubble_sizer = wx.BoxSizer(wx.VERTICAL)
        bubble.SetSizer(bubble_sizer)

        header_row = wx.BoxSizer(wx.HORIZONTAL)
        header = wx.StaticText(bubble, label=role)
        header.SetForegroundColour(header_colour)
        # No SetBackgroundColour: inherits bubble's own bg colour (set in RoundedPanel.__init__).
        header_font = header.GetFont()
        header_font.MakeBold()
        header.SetFont(header_font)
        header_row.Add(header, 0, wx.ALIGN_CENTER_VERTICAL)
        header_row.AddStretchSpacer(1)

        if kind == "assistant" and prompt_cost_usd > 0.0:
            prompt_cost_label = wx.StaticText(bubble, label=f"Prompt: ${prompt_cost_usd:.6f}")
            prompt_cost_label.SetForegroundColour(self.theme_hint)
            cost_font = prompt_cost_label.GetFont()
            cost_font.SetPointSize(max(8, cost_font.GetPointSize() - 1))
            prompt_cost_label.SetFont(cost_font)
            header_row.Add(prompt_cost_label, 0, wx.ALIGN_CENTER_VERTICAL)

        bubble_sizer.Add(header_row, 0, wx.LEFT | wx.RIGHT | wx.TOP | wx.EXPAND, 12)

        content_text = _markdown_to_plain(text) if markdown else text
        body = wx.StaticText(bubble, label=content_text)
        body.SetForegroundColour(fg)
        body.Wrap(self._bubble_wrap_width())
        bubble_sizer.Add(body, 0, wx.ALL, 12)
        self._bubble_bodies.append(body)

        editor: Any = None
        can_edit = kind == "user" and isinstance(history_index, int)
        if can_edit:
            editor = wx.TextCtrl(
                bubble,
                value=text,
                style=wx.TE_MULTILINE | wx.BORDER_NONE,
            )
            editor.SetBackgroundColour(self.input_bg)
            editor.SetForegroundColour(self.theme_fg)
            editor.SetMinSize((self._bubble_wrap_width(), 80))
            editor.Hide()
            bubble_sizer.Add(editor, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM | wx.EXPAND, 12)
            self._bubble_bodies.append(editor)

        card.Add(bubble, 0, wx.EXPAND)

        actions_panel = wx.Panel(self.messages_scroll, style=wx.BORDER_NONE)
        actions_panel.SetBackgroundColour(self.panel_bg)
        actions_row = wx.BoxSizer(wx.HORIZONTAL)
        actions_panel.SetSizer(actions_row)

        copy_btn = self._make_icon_action(
            actions_panel,
            "content_copy",
            "Copier",
            lambda _evt, value=text: self._copy_to_clipboard(value),
        )
        actions_row.Add(copy_btn, 0, wx.RIGHT, 10)

        edit_btn: Any = None
        if can_edit:
            edit_btn = self._make_icon_action(actions_panel, "edit", "Editer", lambda _evt: None)
            actions_row.Add(edit_btn, 0)

        card.Add(actions_panel, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM, 6)

        edit_actions_panel: Any = None
        if can_edit and editor is not None and edit_btn is not None:
            edit_actions_panel = wx.Panel(self.messages_scroll, style=wx.BORDER_NONE)
            edit_actions_panel.SetBackgroundColour(self.panel_bg)
            edit_actions = wx.BoxSizer(wx.HORIZONTAL)
            edit_actions_panel.SetSizer(edit_actions)
            btn_resubmit = self._make_icon_action(edit_actions_panel, "replay", "Resubmit", lambda _evt: None)
            btn_cancel = self._make_icon_action(edit_actions_panel, "close", "Cancel", lambda _evt: None)
            edit_actions.Add(btn_resubmit, 0, wx.RIGHT, 10)
            edit_actions.Add(btn_cancel, 0)
            edit_actions_panel.Hide()
            card.Add(edit_actions_panel, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM, 6)

            def _enter_edit_mode(_evt: wx.CommandEvent) -> None:
                body.Hide()
                editor.Show()
                actions_panel.Hide()
                edit_actions_panel.Show()
                bubble.Layout()
                self.messages_scroll.Layout()
                self.messages_scroll.FitInside()

            def _cancel_edit_mode(_evt: wx.CommandEvent) -> None:
                editor.SetValue(text)
                editor.Hide()
                body.Show()
                actions_panel.Show()
                edit_actions_panel.Hide()
                bubble.Layout()
                self.messages_scroll.Layout()
                self.messages_scroll.FitInside()

            def _resubmit_edit(_evt: wx.CommandEvent) -> None:
                new_text = editor.GetValue().strip()
                if not new_text:
                    wx.MessageBox("Le message ne peut pas etre vide.", "Edit message", wx.OK | wx.ICON_WARNING)
                    return
                self._resubmit_edited_user_message(int(history_index), new_text)

            edit_btn.Bind(wx.EVT_LEFT_UP, _enter_edit_mode)
            btn_cancel.Bind(wx.EVT_LEFT_UP, _cancel_edit_mode)
            btn_resubmit.Bind(wx.EVT_LEFT_UP, _resubmit_edit)

        if kind == "user":
            row.AddStretchSpacer(1)
            row.Add(card, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM, 8)
        else:
            row.Add(card, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM, 8)
            row.AddStretchSpacer(1)

        self.messages_sizer.Add(row, 0, wx.EXPAND)
        self.messages_scroll.Layout()
        self.messages_scroll.FitInside()
        self.messages_scroll.Scroll(0, self.messages_scroll.GetScrollRange(wx.VERTICAL))

    def _clear_messages(self) -> None:
        self.messages_sizer.Clear(delete_windows=True)
        self._bubble_bodies = []
        self._typing_container = None
        self._typing_label = None
        self.messages_scroll.Layout()
        self.messages_scroll.FitInside()

    def _bubble_wrap_width(self) -> int:
        width = self.GetClientSize().GetWidth()
        return max(250, int(width * 0.38))

    def _on_resize(self, event: wx.SizeEvent) -> None:
        wrap = self._bubble_wrap_width()
        for body in self._bubble_bodies:
            if isinstance(body, wx.StaticText):
                body.Wrap(wrap)
            elif isinstance(body, wx.TextCtrl):
                body.SetMinSize((wrap, 80))
        if self._typing_label is not None and isinstance(self._typing_label, wx.StaticText):
            self._typing_label.Wrap(wrap)
        self.messages_scroll.Layout()
        self.messages_scroll.FitInside()
        event.Skip()

    def _set_busy(self, busy: bool) -> None:
        self._is_busy = busy
        self.btn_send.Enable(not busy)
        self.btn_settings.Enable(not busy)
        self.btn_marker.Enable(not busy)
        self.btn_new_chat.Enable(not busy)
        self.btn_delete_chat.Enable(not busy)
        self.chat_list.Enable(not busy)
        self.input.Enable(not busy)

    def _show_typing_indicator(self) -> None:
        if self._typing_container is not None:
            return

        row = wx.BoxSizer(wx.HORIZONTAL)
        bubble = RoundedPanel(self.messages_scroll, bg=self.ai_bg, border=self.border_soft, radius=14)
        bubble_sizer = wx.BoxSizer(wx.VERTICAL)
        bubble.SetSizer(bubble_sizer)

        role = wx.StaticText(bubble, label="AI")
        role.SetForegroundColour(self.theme_hint)
        role_font = role.GetFont()
        role_font.MakeBold()
        role.SetFont(role_font)
        bubble_sizer.Add(role, 0, wx.LEFT | wx.RIGHT | wx.TOP, 12)

        self._typing_label = wx.StaticText(bubble, label="…")
        self._typing_label.SetForegroundColour(self.ai_fg)
        self._typing_label.Wrap(self._bubble_wrap_width())
        bubble_sizer.Add(self._typing_label, 0, wx.LEFT | wx.RIGHT | wx.TOP | wx.BOTTOM, 12)

        row.Add(bubble, 0, wx.LEFT | wx.RIGHT | wx.BOTTOM, 8)
        row.AddStretchSpacer(1)
        self.messages_sizer.Add(row, 0, wx.EXPAND)
        self._typing_container = row

        self.messages_scroll.Layout()
        self.messages_scroll.FitInside()
        self.messages_scroll.Scroll(0, self.messages_scroll.GetScrollRange(wx.VERTICAL))

        self._typing_step = 0
        self._typing_timer.Start(320)

    def _hide_typing_indicator(self) -> None:
        self._typing_timer.Stop()
        if self._typing_container is None:
            return
        self._typing_container = None
        self._typing_label = None
        self._render_history()

    def _on_typing_timer(self, _event: wx.TimerEvent) -> None:
        if self._typing_label is None:
            return
        self._typing_step = (self._typing_step + 1) % 3
        dots = "." * (self._typing_step + 1)
        self._typing_label.SetLabel(dots)
        self.messages_scroll.Layout()
        self.messages_scroll.FitInside()

    def _extract_command_from_text(self, text: str) -> str:
        match = COMMAND_PATTERN.search(text)
        return match.group(1).lower() if match else ""

    def _compute_ai_turn_messages(self, session_dir: str, history_snapshot: List[Dict[str, str]]) -> List[Dict[str, Any]]:
        new_messages: List[Dict[str, Any]] = []

        response = ask_ai(session_dir, history_snapshot)
        if not response.get("ok", False):
            details = response.get("details")
            msg = response.get("message", "Erreur inconnue.")
            new_messages.append({"role": "error", "content": msg, "details": str(details or "")})
            return new_messages

        current_content = str(response.get("content", "")).strip() or "(réponse vide)"
        max_tool_rounds = 3
        temp_history = list(history_snapshot)

        for _ in range(max_tool_rounds):
            command = self._extract_command_from_text(current_content)
            if not command:
                new_messages.append(self._assistant_message_from_response(current_content, response))
                return new_messages

            new_messages.append(self._assistant_message_from_response(current_content, response))
            new_messages.append({"role": "system", "content": f"Commande demandee: {{{command}}}"})

            action_result = execute_action(command, self.board_file, session_dir)
            result_text = self._format_action_result(action_result)
            new_messages.append({"role": "system", "content": "Action result: " + result_text})
            new_messages.append({"role": "system", "content": "Action executee, reprise de l'analyse."})

            temp_history = temp_history + new_messages
            followup_prompt = (
                "Continue your answer using this new tool result. "
                "If no more tool execution is needed, provide the final engineering answer."
            )
            followup_history = list(temp_history)
            followup_history.append({"role": "user", "content": followup_prompt})
            followup = ask_ai(session_dir, followup_history)
            if not followup.get("ok", False):
                details = followup.get("details")
                msg = followup.get("message", "Erreur inconnue.")
                new_messages.append({"role": "error", "content": msg, "details": str(details or "")})
                return new_messages

            current_content = str(followup.get("content", "")).strip() or "(réponse vide)"
            response = followup

        new_messages.append(self._assistant_message_from_response(current_content, response))
        return new_messages

    def _start_async_ai_turn(self) -> None:
        if self._is_busy:
            return
        if not self.current_session_id:
            return

        self._set_busy(True)
        self._show_typing_indicator()

        session_id = self.current_session_id
        session_dir = self.current_session_dir
        history_snapshot = list(self.history)

        def _worker() -> None:
            new_messages = self._compute_ai_turn_messages(session_dir, history_snapshot)
            wx.CallAfter(self._finish_async_ai_turn, session_id, new_messages)

        threading.Thread(target=_worker, daemon=True).start()

    def _finish_async_ai_turn(self, session_id: str, new_messages: List[Dict[str, Any]]) -> None:
        self._hide_typing_indicator()
        self._set_busy(False)

        # If user switched session (should be disabled, but keep guard), persist safely.
        if session_id != self.current_session_id:
            return

        self.history.extend(new_messages)
        self._maybe_set_ai_title()
        self._save_current_session()
        self._update_header_stats()
        self._render_history()

    def _copy_to_clipboard(self, text: str) -> None:
        if wx.TheClipboard.Open():
            wx.TheClipboard.SetData(wx.TextDataObject(text))
            wx.TheClipboard.Close()

    def _format_error_card(self, title: str, details: str) -> str:
        parsed_message = ""
        parsed_type = ""
        parsed_param = ""
        parsed_code = ""

        try:
            parsed = json.loads(details) if details else {}
            err = parsed.get("error", {}) if isinstance(parsed, dict) else {}
            if isinstance(err, dict):
                parsed_message = str(err.get("message", ""))
                parsed_type = str(err.get("type", ""))
                parsed_param = str(err.get("param", ""))
                parsed_code = str(err.get("code", ""))
        except Exception:
            pass

        lines = [f"{title}"]
        if parsed_message:
            lines.append(f"Message: {parsed_message}")
        if parsed_type:
            lines.append(f"Type: {parsed_type}")
        if parsed_param:
            lines.append(f"Param: {parsed_param}")
        if parsed_code:
            lines.append(f"Code: {parsed_code}")
        if details and not parsed_message:
            lines.append("Details:")
            lines.append(details)
        lines.append("Suggestion: essaye un autre model dans Settings si le parametre n'est pas supporte.")
        return "\n".join(lines)

    def _render_history(self) -> None:
        self._clear_messages()
        self._update_header_stats()
        if not self.history:
            self._append_assistant(
                "Assistant prêt. Rien n'est exécuté automatiquement. Pose une question sur le design; je ne lancerai {execute_full}, {execute_drc} ou {execute_erc} que si c'est nécessaire."
            )
            return

        for idx, item in enumerate(self.history):
            role = str(item.get("role", "assistant"))
            content = str(item.get("content", ""))
            if role == "user":
                self._append_message("You", content, markdown=False, kind="user", history_index=idx)
            elif role == "assistant":
                prompt_cost_usd = 0.0
                try:
                    prompt_cost_usd = float(item.get("prompt_cost_usd", 0.0) or 0.0)
                except Exception:
                    prompt_cost_usd = 0.0
                self._append_message(
                    "AI",
                    content,
                    markdown=True,
                    kind="assistant",
                    history_index=idx,
                    prompt_cost_usd=prompt_cost_usd,
                )
            elif role == "system":
                self._append_message("System", content, markdown=False, kind="system", history_index=idx)
            elif role == "error":
                details = str(item.get("details", ""))
                payload = self._format_error_card(content, details)
                self._append_message("API Error", payload, markdown=False, kind="error", history_index=idx)

    def _maybe_set_ai_title(self) -> None:
        title = str(self.current_session_meta.get("title", "New chat"))
        if title != "New chat":
            return

        # Ask AI once we have at least one user turn and one assistant/system turn.
        if len(self.history) < 2:
            return

        ai_title = suggest_chat_title(self.current_session_dir, self.history)
        ai_title = " ".join(ai_title.split()).strip()
        if not ai_title:
            return

        self.current_session_meta["title"] = ai_title[:50]
        self._save_current_session()
        self._refresh_chat_list()
        self._select_session_by_id(self.current_session_id)

    def _on_input_key(self, event: wx.KeyEvent) -> None:
        key_code = event.GetKeyCode()
        if key_code in (wx.WXK_RETURN, wx.WXK_NUMPAD_ENTER):
            if event.CmdDown() or event.ControlDown():
                self.input.WriteText("\n")
            else:
                self._on_send(wx.CommandEvent(wx.EVT_BUTTON.typeId))
            return
        event.Skip()

    def _on_settings(self, _event: wx.CommandEvent) -> None:
        saved = open_settings_dialog(self)
        if saved:
            self._append_assistant("Configuration sauvegardée.")
            self._update_header_stats()

    def _on_send(self, _event: wx.CommandEvent) -> None:
        message = self.input.GetValue().strip()
        if not message:
            return

        if not self.current_session_dir:
            self._append_assistant("Aucune session active.")
            return

        os.makedirs(self.current_session_dir, exist_ok=True)

        self.input.SetValue("")
        self.history.append({"role": "user", "content": message})
        self._save_current_session()
        self._render_history()
        self._start_async_ai_turn()

    def _resubmit_edited_user_message(self, history_index: int, new_text: str) -> None:
        if history_index < 0 or history_index >= len(self.history):
            return

        item = self.history[history_index]
        if str(item.get("role", "")) != "user":
            return

        self.history = self.history[:history_index]
        self.history.append({"role": "user", "content": new_text})
        self._save_current_session()
        self._render_history()
        self._start_async_ai_turn()

    def _format_action_result(self, payload: Dict[str, Any]) -> str:
        action = payload.get("action", "")
        ok = payload.get("ok", False)
        message = payload.get("message", "")
        issue_count = payload.get("issue_count", None)
        returncode = payload.get("returncode", None)
        details = [f"action={action}", f"ok={ok}", f"message={message}"]
        if isinstance(issue_count, int):
            details.append(f"issue_count={issue_count}")
        if isinstance(returncode, int):
            details.append(f"returncode={returncode}")
        stderr = payload.get("stderr", "")
        if stderr:
            details.append(f"stderr={stderr}")
        return "; ".join(details)

    def _on_new_chat(self, _event: wx.CommandEvent) -> None:
        session_id = self._create_session("New chat")
        self._refresh_chat_list()
        self._select_session_by_id(session_id)

    def _on_delete_chat(self, _event: wx.CommandEvent) -> None:
        if not self.current_session_id:
            return

        if self.chat_list.GetCount() <= 1:
            self._append_assistant("Impossible de supprimer le dernier chat.")
            return

        confirm = wx.MessageBox(
            "Supprimer ce chat et son contexte local ?",
            "Confirm delete",
            wx.YES_NO | wx.NO_DEFAULT | wx.ICON_WARNING,
        )
        if confirm != wx.YES:
            return

        session_dir = self._session_dir(self.current_session_id)
        if os.path.isdir(session_dir):
            shutil.rmtree(session_dir, ignore_errors=True)

        self._refresh_chat_list()
        if self._session_items:
            first_id = str(self._session_items[0].get("id", ""))
            if first_id:
                self._select_session_by_id(first_id)

    def _on_select_chat(self, _event: wx.CommandEvent) -> None:
        index = self.chat_list.GetSelection()
        if index < 0 or index >= len(self._session_items):
            return

        session_id = str(self._session_items[index].get("id", ""))
        if session_id and session_id != self.current_session_id:
            self._load_session(session_id)

    def _on_marker(self, _event: wx.CommandEvent) -> None:
        if not self.board_file:
            self._append_assistant("Board file introuvable.")
            return
        if not self.current_session_dir:
            self._append_assistant("Aucune session active.")
            return

        x_text = wx.GetTextFromUser("Position X en pourcentage (0-100)", "Marker", "50")
        if not x_text:
            return
        y_text = wx.GetTextFromUser("Position Y en pourcentage (0-100)", "Marker", "50")
        if not y_text:
            return
        label = wx.GetTextFromUser("Label du marker", "Marker", "Issue")
        if not label:
            label = "Issue"

        try:
            x_percent = float(x_text)
            y_percent = float(y_text)
        except Exception:
            self._append_assistant("Valeurs invalides pour X/Y.")
            return

        exported = export_board_svg(self.board_file, self.current_session_dir)
        if not exported.get("ok", False):
            self._append_assistant(f"Export SVG impossible: {exported.get('message', 'unknown error')}")
            return

        marked = add_svg_marker(str(exported.get("svg_path", "")), x_percent, y_percent, label)
        if not marked.get("ok", False):
            self._append_assistant(f"Annotation impossible: {marked.get('message', 'unknown error')}")
            return

        path = str(marked.get("annotated_svg", ""))
        self._append_assistant(f"Marker ajouté: {path}")


class ChatWindow:
    @staticmethod
    def show(board_file: str, context_dir: str) -> None:
        frame = ChatFrame(board_file=board_file, context_dir=context_dir)
        frame.Show()
